# AWS Cognito User Pool (소셜/로컬 로그인 JWT 검증용)
# 형식: https://cognito-idp.{region}.amazonaws.com/{user-pool-id}
COGNITO_ISSUER_URI=https://cognito-idp.ap-northeast-2.amazonaws.com/ap-northeast-2_dB7hAykk4
# User Pool ID (CognitoService 마이그레이션 + 관리 API용)
COGNITO_USER_POOL_ID=ap-northeast-2_dB7hAykk4
# Identity Pool ID (게스트 비인증 ID 검증용)
COGNITO_IDENTITY_POOL_ID=ap-northeast-2:your-identity-pool-id

# RDS (AWS RDS MySQL)
RDS_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
RDS_USERNAME=admin
RDS_PASSWORD=your-rds-password
# RDS_URL은 위 3개 값으로 자동 구성 (직접 지정 시 아래 주석 해제)
# RDS_URL=jdbc:mysql://${RDS_HOST}:3306/checkdang?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true

# AWS (DynamoDB + Cognito 공통)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# 로컬 개발: http://localhost:8000 / 실제 AWS: 빈칸
DYNAMODB_ENDPOINT=

# Kakao Pay
KAKAO_PAY_SECRET_KEY=your-kakao-pay-secret-key
KAKAO_PAY_CID=TC0ONETIME
KAKAO_PAY_APPROVAL_URL=http://localhost:3000/payment/success
KAKAO_PAY_CANCEL_URL=http://localhost:3000/payment/cancel
KAKAO_PAY_FAIL_URL=http://localhost:3000/payment/fail
KAKAO_PAY_PREMIUM_PRICE=9900
KAKAO_PAY_MOCK_MODE=false   # true면 카카오 API 호출 없이 결제 흐름을 가짜로 시뮬레이션 (CID 미발급 시 시연용)

# Google Play Billing
GOOGLE_PLAY_PACKAGE_NAME=com.checkdang
# GCP 서비스 계정 JSON 키를 Base64 인코딩한 값
# 인코딩: base64 -i service-account.json | tr -d '\n'
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=your-base64-encoded-service-account-json
GOOGLE_PLAY_SUBSCRIPTION_ID=premium_monthly
GOOGLE_PLAY_MOCK_MODE=false   # true면 AndroidPublisher API 호출 없이 isPremium: true 반환 (Play Console API 액세스 미설정 시 시연용)

# AI 서버
AI_SERVER_URL=http://localhost:8000
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# API Gateway (Cognito Authorizer 적용된 엔드포인트 — 앱 Base URL로 사용)
API_GATEWAY_URL=https://it6dsrn3l1.execute-api.ap-northeast-2.amazonaws.com/prod
