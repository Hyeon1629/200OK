<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@color/divider" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_part_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/TextAppearance.CheckDang.Title2"
            android:textColor="@color/text_primary"
            tools:text="허리 통증 기록" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="강도와 통증의 성질·상황을 기록하세요"
            android:textAppearance="@style/TextAppearance.CheckDang.Caption"
            android:textColor="@color/text_secondary" />

        <!-- 통증 강도 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="통증 강도"
            android:textAppearance="@style/TextAppearance.CheckDang.Body1"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:id="@+id/layout_intensity_dots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <View android:id="@+id/dot1"
                android:layout_width="28dp" android:layout_height="28dp"
                android:layout_marginHorizontal="6dp" android:background="@drawable/bg_intensity_dot" />
            <View android:id="@+id/dot2"
                android:layout_width="28dp" android:layout_height="28dp"
                android:layout_marginHorizontal="6dp" android:background="@drawable/bg_intensity_dot" />
            <View android:id="@+id/dot3"
                android:layout_width="28dp" android:layout_height="28dp"
                android:layout_marginHorizontal="6dp" android:background="@drawable/bg_intensity_dot" />
            <View android:id="@+id/dot4"
                android:layout_width="28dp" android:layout_height="28dp"
                android:layout_marginHorizontal="6dp" android:background="@drawable/bg_intensity_dot" />
            <View android:id="@+id/dot5"
                android:layout_width="28dp" android:layout_height="28dp"
                android:layout_marginHorizontal="6dp" android:background="@drawable/bg_intensity_dot" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekbar_intensity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:max="4"
            android:progress="2"
            android:progressTint="@color/brand_green"
            android:thumbTint="@color/brand_green" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="22dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="약함"
                android:textAppearance="@style/TextAppearance.CheckDang.Caption"
                android:textColor="@color/text_secondary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="심함"
                android:textAppearance="@style/TextAppearance.CheckDang.Caption"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 통증 성질 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="통증 성질 (어떤 느낌인지 · 복수 선택)"
            android:textAppearance="@style/TextAppearance.CheckDang.Body1"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:id="@+id/container_quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp" />

        <!-- 통증 상황 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="통증 상황 (언제 아픈지 · 복수 선택)"
            android:textAppearance="@style/TextAppearance.CheckDang.Body1"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:id="@+id/container_situation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <!-- 저장 / AI 분석 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_analyze"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="기록 저장하고 AI 분석 받기"
            android:textAppearance="@style/TextAppearance.CheckDang.Body1"
            app:cornerRadius="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
