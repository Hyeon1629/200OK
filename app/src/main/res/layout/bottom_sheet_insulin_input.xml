<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 타이틀 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="인슐린 입력"
            android:textAppearance="@style/TextAppearance.CheckDang.Title2"
            android:textColor="@color/text_primary" />

        <!-- 주입량 입력 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_units"
            style="@style/Widget.CheckDang.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="주입량"
            app:suffixText="U">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_units"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textAppearance="@style/TextAppearance.CheckDang.Display"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 인슐린 종류 라벨 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="인슐린 종류"
            android:textAppearance="@style/TextAppearance.CheckDang.Body2"
            android:textColor="@color/text_primary" />

        <!-- 종류 ChipGroup (단일 선택) -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_type_rapid"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="속효성"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_type_long"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="지속형(기저)"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_type_mixed"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="혼합형"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_type_other"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기타"
                app:checkedIconVisible="false" />
        </com.google.android.material.chip.ChipGroup>

        <!-- 주입 시각 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="주입 시각"
            android:textAppearance="@style/TextAppearance.CheckDang.Body2"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_injected_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/background_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:textAppearance="@style/TextAppearance.CheckDang.Body1"
            android:textColor="@color/text_primary" />

        <!-- 메모 입력 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_memo"
            style="@style/Widget.CheckDang.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="메모 (선택)"
            app:counterEnabled="true"
            app:counterMaxLength="200">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_memo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:maxLength="200" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 저장 버튼 -->
        <Button
            android:id="@+id/btn_save"
            style="@style/Widget.CheckDang.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="저장" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
