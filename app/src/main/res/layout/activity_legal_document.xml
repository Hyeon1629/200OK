<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_secondary">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background_primary"
        android:elevation="2dp"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:titleTextColor="@color/text_primary"
        app:titleTextAppearance="@style/TextAppearance.CheckDang.Title2" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- 메타 정보 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/background_primary"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CheckDang.Body2"
                        android:textColor="@color/brand_green"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_meta_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.CheckDang.Caption"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 본문 — Markwon 렌더링 -->
            <TextView
                android:id="@+id/tv_document"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.CheckDang.Body1"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.4"
                android:textIsSelectable="true" />

            <!-- Privacy 전용: 보호책임자 문의 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_contact"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:minWidth="200dp"
                android:paddingHorizontal="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:singleLine="true"
                android:gravity="center"
                android:text="@string/legal_contact_button"
                android:visibility="gone"
                app:cornerRadius="12dp"
                app:strokeColor="@color/brand_green"
                android:textColor="@color/brand_green" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Terms 전용: 동의 footer (MODE_AGREEMENT 일 때만 노출) -->
    <LinearLayout
        android:id="@+id/footer_agreement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/background_primary"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/legal_agreement_label"
            android:textAppearance="@style/TextAppearance.CheckDang.Body2"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_agree"
            style="@style/Widget.CheckDang.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="160dp"
            android:paddingHorizontal="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:singleLine="true"
            android:text="@string/legal_agreement_button" />

    </LinearLayout>

</LinearLayout>
