# Built application files
*.apk
*.aar
*.ap_
*.aab

# Samsung Health Data SDK (Partner 미배포 + 개발자 모드 전용 라이브러리) — 의도적으로 포함
!app/libs/*.aar

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# JVM heap dumps (Gradle OOM 진단용으로 -XX:+HeapDumpOnOutOfMemoryError 가 떨어뜨림)
*.hprof

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
*.iws
*.ipr

# Keystore files
*.jks
*.keystore

# Google Services
# (google-services.json 은 의도적으로 포함하므로 제외하지 않음)

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# MacOS
.DS_Store
